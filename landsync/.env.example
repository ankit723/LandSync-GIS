DATABASE_URL=postgres://landsync:landsync@localhost:5433/landsync
REDIS_URL=redis://localhost:6380
LANDSTACK_SESSION_SECRET=change-me
COOKIE_SECURE=false

# Mock departmental APIs (Phase 2 integration layer)
DEPT_API_BASE=http://localhost:4000
DEPT_API_KEY=dept-dev-key
DEPT_PORT=4000
DEPT_LATENCY_MS=60
DEPT_FAILURE_RATE=0
# ALLOW_ROLE_LOGIN=false

# Seed password for every demo user
SEED_PASSWORD=landsync

# AI / LLM (optional). Without a key, NL queries fall back to the rule-based parser.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Map basemap. All NEXT_PUBLIC_* are inlined at build time — rebuild / restart dev after changing.
# Configure the "Light" basemap ONE of these ways:
#   a) CARTO account token (removes the anonymous-origin watermark):
# NEXT_PUBLIC_CARTO_TOKEN=eyJhbGci...
# NEXT_PUBLIC_CARTO_BASEMAP=light_all          # or rastertiles/voyager, dark_all, light_nolabels
#   b) any raster provider with the key baked into the URL:
# NEXT_PUBLIC_LIGHT_TILES=https://api.maptiler.com/maps/dataviz-light/{z}/{x}/{y}.png?key=YOUR_KEY
#   c) a full vector style.json:
# NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# NEXT_PUBLIC_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
